# Copy to `.env` and fill in only the keys you want. Every key is OPTIONAL —
# the tool runs fully with ZERO keys (yfinance + local GEX + yfinance-news
# catalysts). Never commit your real .env (it is in .gitignore).

# --- Catalysts (Stage 1) ---------------------------------------------------
# Finnhub free tier: 60 calls/min (~300/day). https://finnhub.io  (free signup)
# Without this, catalysts fall back to yfinance news (no key).
FINNHUB_API_KEY=

# --- GEX cross-check (Stage 3) ---------------------------------------------
# FlashAlpha free tier: 5 GEX requests/day. https://flashalpha.com (free signup)
# Without this, GEX is computed locally only (the source of truth regardless).
FLASHALPHA_API_KEY=
# Verify the path/host against https://flashalpha.com/docs/lab-api-gex if the
# hosted cross-check numbers don't show up; the adapter fails safe to local GEX.
# FLASHALPHA_BASE_URL=https://api.flashalpha.com
# FLASHALPHA_GEX_PATH=/v1/gex

# --- Option chains: REAL open interest + greeks (Stage 0/3/4/5) -------------
# Tradier (free with an account): option chains with real OI + native greeks
# (delta/gamma/theta/vega + IV via ORATS). Set this and the morning run gets
# real GEX instead of yfinance's often-zeroed off-hours OI. WIRED — used
# automatically for option chains whenever TRADIER_API_KEY is present.
TRADIER_API_KEY=
# Use the sandbox host for paper/delayed data; set REALTIME=1 if your account
# has real-time market data (otherwise chains are flagged delayed).
# TRADIER_BASE_URL=https://sandbox.tradier.com/v1
# TRADIER_REALTIME=1

# --- Optional future upgrades (not wired) -----------------------------------
# Polygon / Tiingo: faster/cleaner quotes & fundamentals (paid).
POLYGON_API_KEY=
TIINGO_API_KEY=

# --- Book overrides (defaults shown) ---------------------------------------
# BOOK_SIZE=2000
# DEFAULT_RISK_PCT=0.10        # 10% per trade ($200). Lower it here to de-risk.
# RISK_FREE_RATE=0.043
# SINGLE_NAME_GEX_MIN_MARKET_CAP=200e9
# SWINGDESK_DEMO=1             # make refresh.py use synthetic demo data
